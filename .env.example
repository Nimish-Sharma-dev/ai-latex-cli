# ==============================================================================
# AI LaTeX CLI Configuration — Free & Multi-Provider Settings
# ==============================================================================
# The system works 100% FREE out-of-the-box using the built-in Antigravity engine.
# You can also plug in Google Gemini (Free Tier), Groq (Free Tier), or local Ollama.

# Active Provider: antigravity (default free), gemini, groq, ollama, deepseek
LLM_PROVIDER=antigravity

# --- Free Tier Option 1: Google Gemini (Free 15 RPM / 1M TPM) ---
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Free Tier Option 2: Groq Cloud (Free high-speed inference) ---
# Get key: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Free Tier Option 3: Ollama (100% offline, local, private) ---
# Download: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Legacy Option: DeepSeek API (Paid) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# General Generation Parameters
TEMPERATURE=0.2
MAX_TOKENS=4096

# LaTeX Engine Settings
LATEX_COMPILER=pdflatex
LATEX_COMPILE_TIMEOUT=120
TEMPLATE_DIR=./templates
OUTPUT_DIR=./outputs
BACKUP_ENABLED=true
